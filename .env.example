# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
IOT_SERVER_PORT=7000
AGENT_PORT=9000
POSTGRES_PORT=5432


# Service URLs (used inside containers - service names as hostnames)
IOT_SERVER_URL=http://iot-server:7000
BACKEND_URL=http://backend:8000


# Database
POSTGRES_DB=sicc
POSTGRES_HOST=db

DB_BACKEND_USER=backend
DB_BACKEND_PASSWORD=backendpass

DB_IOT_USER=iot_server
DB_IOT_PASSWORD=iotpass


# Environment
ENV=development


# env/.env.db
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpass

# env/.env.backend
JWT_SECRET_KEY=your_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# env/.env.iot


# env/.env.frontend
CHOKIDAR_USEPOLLING=true