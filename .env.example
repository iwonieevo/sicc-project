# ============================================================================
# SICC - Secure IoT Control Center
# ============================================================================
# Copy this file to .env and fill in your values
# ============================================================================
# 
# ENVIRONMENT VARIABLES OVERVIEW:
#
# Root (.env):
#   FRONTEND_PORT, BACKEND_PORT, IOT_SERVER_PORT, AGENT_NET_NAME
#   POSTGRES_DB, POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD
#   DB_BACKEND_USER, DB_BACKEND_PASSWORD, DB_IOT_USER, DB_IOT_PASSWORD
#
# env/.env.backend:
#   JWT_SECRET_KEY, JWT_ALGORITHM, JWT_ACCESS_TOKEN_EXPIRE_MINUTES
#   IOT_SERVER_URL
#
# env/.env.agent:
#   POLL_INTERVAL, IOT_SERVER_URL
#
# env/.env.frontend:
#   CHOKIDAR_USEPOLLING
#
# ============================================================================

# ----------------------------------------------------------------------------
# Root (.env)
# ----------------------------------------------------------------------------

FRONTEND_PORT=3000
BACKEND_PORT=8000
IOT_SERVER_PORT=7000

AGENT_NET_NAME=sicc-agent-net

POSTGRES_DB=sicc
POSTGRES_HOST=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_password

DB_BACKEND_USER=backend
DB_BACKEND_PASSWORD=change_this_password

DB_IOT_USER=iot_server
DB_IOT_PASSWORD=change_this_password

# ----------------------------------------------------------------------------
# env/.env.backend
# ----------------------------------------------------------------------------
# Create this file with the following content:

# JWT_SECRET_KEY=your_super_secret_key_change_in_production
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# IOT_SERVER_URL=http://iot-server:7000

# ----------------------------------------------------------------------------
# env/.env.agent
# ----------------------------------------------------------------------------
# Create this file with the following content:

# POLL_INTERVAL=2
# IOT_SERVER_URL=http://iot-server:7000

# ----------------------------------------------------------------------------
# env/.env.frontend
# ----------------------------------------------------------------------------
# Create this file with the following content:

# CHOKIDAR_USEPOLLING=true